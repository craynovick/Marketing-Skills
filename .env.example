AI_GATEWAY_API_KEY=
# Optional BYOK provider credentials. The current hosted analysis route uses
# AI_GATEWAY_API_KEY; provider routing is an implementation milestone.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for durable worker writes; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after applying and verifying the guided brand migration in preview.
COOKBOOK_V2_ENABLED=false
COOKBOOK_MODEL=openai/gpt-5.6-sol
# Comma-separated emails with admin entitlements (server-side only).
ADMIN_EMAILS=craynovick@gmail.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Enable only after applying migrations and verifying a configured preview.
COOKBOOK_INTEGRATIONS_ENABLED=false
# hosted or self-hosted; never accept this setting from a client request.
COOKBOOK_DEPLOYMENT=hosted

# Enable after brands/adaptations migrations and preview acceptance.
COOKBOOK_BRANDS_ENABLED=false

# Enable only after the portable brand-pack migration and configured-preview checks.
COOKBOOK_BRAND_PACKS_ENABLED=false
